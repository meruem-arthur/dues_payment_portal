# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Public app URL (used for payment callback + webhook construction)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Per-department payment credentials are stored in the database ---
# (PaymentProviderConfiguration table), configured by the Super Admin
# through the Departments UI, NOT as global env vars, since each
# department may have its own Paystack account. These vars are only
# used as defaults / for local testing convenience.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# SMS provider (mocked/logged-only until this is set - see src/lib/sms/provider-factory.ts)
# Set to AFRICASTALKING to send real SMS. Each department's own apiKey/username
# is configured separately in the app under Departments > SMS Settings, not here.
SMS_PROVIDER=

# Email provider (mocked/logged-only until this is set - see src/lib/email/provider-factory.ts)
# Set to BREVO to send real email. Unlike SMS, this is ONE shared account
# for the whole app (not per-department) - get EMAIL_API_KEY from your Brevo
# dashboard under SMTP & API > API Keys. Free tier caps at 300 emails/day,
# account-wide.
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Must be a sender address verified in your Brevo dashboard (Senders,
# Domains & Dedicated IPs > Senders). Used whenever a department hasn't set
# its own fromAddress under Departments > Email Settings.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Encrypts secretKey/webhookSecret/apiKey at rest (see src/lib/crypto/field-encryption.ts).
# REQUIRED before saving or rotating any payment/SMS credentials through the
# admin UI - generate with:  openssl rand -base64 32
# Existing plaintext values keep working if this isn't set yet, but nothing
# NEW can be saved without it.
ENCRYPTION_KEY=

# Error monitoring (see src/lib/monitoring/capture-error.ts). Optional -
# without this, errors still log to the console exactly as before; setting
# it additionally reports them to Sentry. Get a DSN from sentry.io (free
# tier is fine for a project this size).
SENTRY_DSN=
