# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Public app URL (used for payment callback + webhook construction)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Per-department payment credentials are stored in the database ---
# (PaymentProviderConfiguration table), configured by the Super Admin
# through the Departments UI, NOT as global env vars, since each
# department may have its own Paystack account. These vars are only
# used as defaults / for local testing convenience.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# SMS provider (mocked until these are set - see src/lib/sms/provider-factory.ts)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_USERNAME=
SMS_SENDER_ID=

# Email provider (mocked until set - see src/lib/email/provider-factory.ts)
EMAIL_API_KEY=
